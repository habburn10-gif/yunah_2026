# 4. [정의 def] 전체 웹앱 화면을 실행하는 메인 함수
def main():
    show_header()

    # [리스트 list] 3교대 근무 선택지 목록
    shift_list = [
        "데이 (Day / 07:00 ~ 15:00)",
        "이브닝 (Evening / 15:00 ~ 23:00)",
        "나이트 (Night / 23:00 ~ 07:00)",
    ]

    col1, col2 = st.columns(2)
    with col1:
        shift = st.selectbox("현재(또는 직전) 근무 형태를 선택하세요", shift_list)
    with col2:
        rest_hours = st.number_input(
            "다음 근무까지 남은 휴식 시간 (시간)",
            min_value=1.0,
            max_value=72.0,
            value=12.0,
            step=0.5,
        )

    # [선택 구조 if] 진단 버튼 클릭 시 결과 계산 및 화면 출력
    if st.button("📋 피로도 진단 및 행동 가이드 받기", use_container_width=True, type="primary"):
        total_score, bonus_score, status, badge_color = evaluate_fatigue(shift, rest_hours)

        st.divider()

        m1, m2, m3 = st.columns(3)
        m1.metric("총 피로 위험 점수", f"{total_score}점")
        m2.metric("휴식 부족 가산점", f"+{bonus_score}점" if bonus_score > 0 else "0점 (11시간 초과)")
        m3.metric("현재 상태 판정", f"{badge_color} {status}")

        # [선택 구조 if / elif / else] 상태에 따른 경고/안내 메시지 출력
        if status == "위험":
            st.error(
                f"🚨 **[위험] 피로도가 매우 높습니다 ({total_score}점)!** "
                "수면 박탈 및 생체리듬 붕괴 위험이 큽니다. 즉시 아래 회복 가이드를 최우선으로 실행하세요."
            )
        elif status == "주의":
            st.warning(
                f"⚠️ **[주의] 피로가 누적되고 있습니다 ({total_score}점).** "
                "컨디션 저하를 막기 위해 계획적인 수면 위생 관리가 필요합니다."
            )
        else:
            st.success(
                f"✅ **[양호] 비교적 안정적인 휴식 상태입니다 ({total_score}점).** "
                "현재의 좋은 리듬을 유지할 수 있도록 아래 가이드를 실천해 보세요."
            )

        st.subheader("📌 상황별 맞춤 행동 가이드")
        df_guide = make_guide_table(status)
        st.table(df_guide.set_index("순서"))

        # [선택 구조 if] 11시간 이하 휴식일 때 안내 문구 추가
        if rest_hours <= 11:
            st.caption("ℹ️ *남은 휴식 시간이 11시간 이하(법정 최소 휴식 기준 근접)이므로 피로 가산점 15점이 반영되었습니다.*")


# 프로그램 시작점
if __name__ == "__main__":
    main()
