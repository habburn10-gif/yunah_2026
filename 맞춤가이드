# 1. [정의 def] 상단 배너 및 접속 상태를 출력하는 함수
def show_header():
    st.markdown(
        """
        <div style="
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
            padding: 30px 24px;
            border-radius: 16px;
            color: white;
            text-align: center;
            margin-bottom: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        ">
            <h1 style="margin: 0; font-size: 1.9rem; font-weight: 700;">
                🩺 간호사 3교대 맞춤형 수면·휴식 가이드
            </h1>
            <p style="margin: 10px 0 0 0; font-size: 1.0rem; color: #dbeafe; line-height: 1.5;">
                불규칙한 듀티 속에서도 지치지 않도록, 현재 근무 형태와 휴식 시간을 분석해<br>
                피로 위험도 진단과 딱 맞는 회복 행동 가이드를 처방해 드립니다.
            </p>
        </div>
        """,
        unsafe_allow_html=True,
    )

    # [선택 구조 if] 첫 접속 시에만 환영 알림 및 접속 시간 저장
    if "connected" not in st.session_state:
        st.session_state.connected = True
        st.session_state.connect_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        st.toast("🩺 오늘도 고생 많으셨습니다! 수면 가이드 앱에 접속되었습니다.", icon="✨")

    st.caption(f"🟢 **시스템 상태:** 사용자 접속 완료 (접속 시간: {st.session_state.connect_time})")
    st.divider()


# 2. [정의 def] 근무 형태와 남은 휴식 시간을 바탕으로 피로도와 상태를 계산하는 함수
def evaluate_fatigue(shift, rest_hours):
    # [선택 구조 if / elif / else] 근무 형태별 기본 피로 점수 + random 변동폭
    if "나이트" in shift:
        base_score = random.randint(55, 68)
    elif "이브닝" in shift:
        base_score = random.randint(42, 58)
    else:  # 데이
        base_score = random.randint(30, 48)

    # [선택 구조 if / else] 남은 휴식 시간이 11시간 이하일 경우 가산점 15점 추가
    if rest_hours <= 11:
        bonus_score = 15
    else:
        bonus_score = 0

    total_score = base_score + bonus_score

    # [선택 구조 if / elif / else] 총점 기준에 따른 상태 판정 (위험 / 주의 / 양호)
    if total_score >= 70:
        status = "위험"
        badge_color = "🔴"
    elif total_score >= 50:
        status = "주의"
        badge_color = "🟡"
    else:
        status = "양호"
        badge_color = "🟢"

    return total_score, bonus_score, status, badge_color


